<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Path" x:Key="TitleBarIconBase">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Stroke" Value="{DynamicResource BrushText}" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    
    <Style TargetType="Path" x:Key="TitleBar_Minimize" BasedOn="{StaticResource TitleBarIconBase}">
        <Setter Property="Data" Value="M 15,24 H 25" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>

    <Style TargetType="Path" x:Key="TitleBar_Maximize" BasedOn="{StaticResource TitleBarIconBase}">
        <Setter Property="Data" Value="M 15,15 H 25 V 25 H 15 Z" />
    </Style>

    <Style TargetType="Path" x:Key="TitleBar_Restore" BasedOn="{StaticResource TitleBarIconBase}">
        <Setter Property="Data" Value="M 17,15 H 25 V 23 M 15,17 H 23 V 25 H 15 Z" />
    </Style>

    <Style TargetType="Path" x:Key="TitleBar_Close" BasedOn="{StaticResource TitleBarIconBase}">
        <Setter Property="Data" Value="M 15,15 L 25,25 M 25,15 L 15,25" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>

</ResourceDictionary>