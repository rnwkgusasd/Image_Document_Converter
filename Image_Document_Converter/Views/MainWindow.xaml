<Window x:Class="Image_Document_Converter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Image_Document_Converter"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:IDC.ViewModels"
        xmlns:cvt="clr-namespace:IDC.Converter"
        xmlns:helper="clr-namespace:IDC.Helper"
        mc:Ignorable="d"
        Title="Document Converter" Height="800" Width="1200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" 
                      ResizeBorderThickness="8" 
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <cvt:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisible" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Border CornerRadius="8" Background="{DynamicResource BrushBackground}" BorderThickness="1" BorderBrush="Gray">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="1" />
                <RowDefinition />
                <RowDefinition Height="1" />
                <RowDefinition Height="10" />
            </Grid.RowDefinitions>

            <!-- 구분 선 -->
            <Border Grid.Row="1" BorderThickness="0" Background="Gray" Margin="10,0" />
            <Border Grid.Row="3" BorderThickness="0" Background="Gray" Margin="10,0" />

            <!-- 타이틀 바 영역 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBarMouseLeftDownEvent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleButtonStyle}" Click="WindowMinimizingEvent">
                    <Path Style="{StaticResource TitleBar_Minimize}" />
                </Button>
                <Button Grid.Column="2" WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleButtonStyle}" Click="WindowMaximizedEvent">
                    <Path>
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource TitleBar_Maximize}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Data" Value="M 17,15 H 25 V 23 M 15,17 H 23 V 25 H 15 Z" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button Grid.Column="3" WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleCloseButtonStyle}" Click="WindowCloseEvent">
                    <Path Style="{StaticResource TitleBar_Close}" />
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" AllowDrop="True" 
                      helper:FileDropBehavior.DropCommand="{Binding FileDropCommand}"
                      helper:FileDropBehavior.OverlayElement="{Binding ElementName=DragOverBorder}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="1" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="1" BorderThickness="0" Background="Gray" Margin="10,0,0,0" />

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Command="{Binding OpenItemsCommand}">
                            <Path Width="30" Height="30" Fill="#2196F3" Data="M 6,8 H 12 L 14,11 H 24 V 24 H 6 Z" />
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Command="{Binding ClearItemListCommand}">
                            <Path Width="30" Height="30" Fill="#2196F3" Data="M 11,4 H 19 V 6 H 24 V 9 H 6 V 6 H 11 Z M 8,11 H 22 L 20,25 H 10 Z" />
                        </Button>

                        <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}" Command="{Binding RotateImageCommand}" CommandParameter="90">
                            <Path Width="30" Height="30" Fill="#2196F3" Data="M15,5 C9.48,5 5,9.48 5,15 C5,20.52 9.48,25 15,25 C18.15,25 20.94,23.55 22.75,21.32 L20.32,18.89 C19.04,20.51 17.13,21.5 15,21.5 C11.41,21.5 8.5,18.59 8.5,15 C8.5,11.41 11.41,8.5 15,8.5 C17.38,8.5 19.46,9.79 20.57,11.72 L17.5,11.72 L17.5,14.72 L25,14.72 L25,7.22 L22,7.22 L22,9.66 C20.45,7.19 17.92,5.5 15,5 Z" />
                        </Button>
                        <Button Grid.Column="6" Style="{StaticResource IconButtonStyle}" Command="{Binding RotateImageCommand}" CommandParameter="-90">
                            <Path Width="30" Height="30" Fill="#2196F3" Data="M15,5 C12.08,5 9.55,7.19 8,9.66 L8,7.22 L5,7.22 L5,14.72 L12.5,14.72 L12.5,11.72 L9.43,11.72 C10.54,9.79 12.62,8.5 15,8.5 C18.59,8.5 21.5,11.41 21.5,15 C21.5,18.59 18.59,21.5 15,21.5 C12.87,21.5 10.96,20.51 9.68,18.89 L7.25,21.32 C9.06,23.55 11.85,25 15,25 C20.52,25 25,20.52 25,15 C25,9.48 20.52,5 15,5 Z" />
                        </Button>

                        <Button Grid.Column="7" Style="{StaticResource IconButtonStyle}" Command="{Binding PreviewToggleCommand}">
                            <Path Width="30" Height="30" Fill="#2196F3" Data="M 4,6 H 26 V 24 H 4 Z M 8,10 H 22 V 20 H 8 Z M 18,12 A 1.5,1.5 0 1,1 18,12.01 M 10,18 L 13,14 L 16,18 L 18,16 L 20,18 Z" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150" />
                            <ColumnDefinition Width="5" helper:GridColumnHelper.IsVisible="{Binding IsPreviewVisible}" />
                            <ColumnDefinition x:Name="PreviewColumn" Width="300" helper:GridColumnHelper.IsVisible="{Binding IsPreviewVisible}" />
                        </Grid.ColumnDefinitions>

                        <Thumb Grid.Column="1" Width="5" Cursor="SizeWE" Background="Gray" DragDelta="Splitter_DragDelta"
                            Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisible}}" />

                        <ItemsControl ItemsSource="{Binding ItemList}" Background="Transparent">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Command" Value="{Binding DataContext.ItemClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <Setter Property="CommandParameter" Value="{Binding}" />
                                                <Setter Property="ToolTip" Value="{Binding FileInfo.FullName}" />

                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Margin="10, 2" Height="30" BorderThickness="0, 0, 0, 1" BorderBrush="LightGray" Background="{TemplateBinding Background}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <Image Grid.Column="1" Source="{Binding IconUri}" Width="20" Height="20" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding FileName}" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background">
                                                                        <Setter.Value>
                                                                            <SolidColorBrush Color="Black" Opacity="0.1" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="Background">
                                                                        <Setter.Value>
                                                                            <SolidColorBrush Color="Black" Opacity="0.15" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background">
                                                                        <Setter.Value>
                                                                            <SolidColorBrush Color="LightSkyBlue" Opacity="0.3" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Grid.Column="2" Background="Gray"
                              Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisible}}">
                            <Image Margin="20" Stretch="Uniform" Source="{Binding SelectedImage}" />
                        </Grid>
                    </Grid>

                    <Border Grid.RowSpan="3" x:Name="DragOverBorder" Visibility="Collapsed">
                        <Border.Background>
                            <SolidColorBrush Color="Black" Opacity="0.5" />
                        </Border.Background>

                        <Border VerticalAlignment="Center" HorizontalAlignment="Center" BorderThickness="3" BorderBrush="{DynamicResource BrushText}" CornerRadius="50" Width="450" Height="100">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="1" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <!-- 1. 바깥쪽 동그라미 (아웃라인 스타일) -->
                                    <Path Stroke="{DynamicResource BrushText}" 
                                            StrokeThickness="3"
                                            Data="M 5,25 A 20,20 0 1,0 45,25 A 20,20 0 1,0 5,25" />

                                    <!-- 2. 안쪽 플러스(+) 모양 -->
                                    <Path Fill="{DynamicResource BrushText}"
                                            Data="M 23,16 H 27 V 23 H 34 V 27 H 27 V 34 H 23 V 27 H 16 V 23 H 23 Z" />

                                </Grid>
                                <TextBlock Grid.Column="3" Text="파일을 여기에 드롭해주세요" VerticalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushText}" />
                            </Grid>
                        </Border>
                    </Border>

                </Grid>

                <Grid Grid.Column="1" Width="200">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" IsChecked="{Binding IsUseOnePdf, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" Text="이미지 파일 전체 하나의 PDF로 저장" />
                    </Grid>
                    
                    <Button Grid.Row="1" Content="IMG to PDF" Command="{Binding ConvertImageToPdfCommand}" />
                    <Button Grid.Row="2" Content="PDF to JPG" Command="{Binding ConvertPdfToJpgCommand}" />
                    <Button Grid.Row="3" Content="HEIC to JPG" Command="{Binding ConvertHeicToJpgCommand}" />

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
